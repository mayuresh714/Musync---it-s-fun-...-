      ],
      "properties": {
       "look": {
        "enum": [
         "static",
         "cycle",
         "split",
         "gradient",
         "rainbow",
         "sweep",
         "pairs",
         "fire",
         "tide"
        ]
       },
       "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "speed": {
        "type": "number",

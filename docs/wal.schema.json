       }
      },
      "additionalProperties": false
     },
     "fx": {
      "enum": [
       "flash",
       "blackout",
       "burst",
       "snap",
       "co2",
       "confetti",
       "flame",
       "spark",
       "streamers"
      ]
     },
     "dur": {
      "type": "number",
      "minimum": 0
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "accents": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "t",
     "type"
    ],
    "properties": {
     "t": {
      "type": "number",
      "minimum": 0
     },
     "type": {
      "enum": [
       "drop",
       "hit",
       "silence",
       "riser",
       "cue"
      ]
     },
     "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "dur": {
      "type": "number",
      "minimum": 0
     },
     "fx": {
      "enum": [
       "flash",
       "blackout",
       "burst",
       "snap",
       "co2",
       "confetti",
       "flame",
       "spark",
       "streamers",
       "none"
      ]
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "onsets": {
   "type": "object",
   "properties": {
    "low": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number"
      }
     }
    },
    "mid": {
     "type": "array",

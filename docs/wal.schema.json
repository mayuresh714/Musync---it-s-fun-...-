         "high"
        ]
       },
       "palette": {
        "type": "string"
       },
       "index": {
        "type": "integer",
        "minimum": 0
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       },
       "pose": {
        "enum": [

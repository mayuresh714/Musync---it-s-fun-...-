{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://musync.app/schema/wal-1.json",
 "title": "WAL — Wave Augmented Language v1",
 "type": "object",
 "required": [
  "wal",
  "meta",
  "timing",
  "sections"
 ],
 "properties": {
  "wal": {
   "const": "1.0"
  },
  "meta": {
   "type": "object",
   "required": [
    "title",
    "duration"
   ],
   "properties": {
    "title": {
     "type": "string"
    },
    "artist": {
     "type": "string"
    },
    "duration": {
     "type": "number",
     "minimum": 0
    },
    "bpm": {
     "type": "number",
     "minimum": 20,
     "maximum": 300
    },
    "meter": {
     "type": "integer",
     "minimum": 2,
     "maximum": 12
    },
    "key": {
     "type": "string"
    },
    "styles": {
     "type": "array",
     "items": {
      "enum": [
       "edm",
       "bollywood",
       "dandiya",
       "concert",
       "devotional",
       "wedding",
       "romantic",
       "rock",
       "hiphop",
       "sufi",
       "classical",
       "folk",
       "pop"
      ]
     }
    },
    "mood": {
     "type": "string"
    },
    "language": {
     "type": "string"
    },
    "audio": {
     "type": "object",
     "properties": {
      "file": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "duration": {
       "type": "number",
       "minimum": 0
      }
     }
    },
    "generator": {
     "type": "string"
    },
    "created": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "timing": {
   "type": "object",
   "required": [
    "beats"
   ],
   "properties": {
    "beats": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0
     }
    },
    "downbeats": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0
     }
    }
   }
  },
  "palettes": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    }
   }
  },
  "sections": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "start",
     "end",
     "kind",
     "energy"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "start": {
      "type": "number",
      "minimum": 0
     },
     "end": {
      "type": "number",
      "minimum": 0
     },
     "kind": {
      "enum": [
       "intro",
       "aalap",
       "verse",
       "prechorus",
       "chorus",
       "build",
       "drop",
       "break",
       "bridge",
       "solo",
       "interlude",
       "outro"
      ]
     },
     "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "group": {
      "type": "string"
     },
     "label": {
      "type": "string",
      "description": "Human label, e.g. \"Mukhda\", \"Antara 1\", \"Drop 2\"."
     },
     "mood": {
      "type": "string"
     },
     "palette": {
      "type": "string"
     },
     "lyric": {
      "type": "string",
      "description": "Key lyric line or meaning, for the creative layer."
     },
     "move": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Movement figures the director chose for this section (names from the MOVE looks)."
     }
    }
   }
  },
  "motifs": {
   "type": "object",
   "description": "Recurring phrases of the song, by id. Phrases point at them.",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "gist": {
      "type": "string"
     },
     "role": {
      "enum": [
       "refrain",
       "tagline",
       "line",
       "answer",
       "lift",
       "instrumental",
       "silence"
      ]
     }
    }
   }
  },
  "phrases": {
   "type": "array",
   "description": "The lyric architecture: lines, refrains and taglines in time order. Cues follow them.",
   "items": {
    "type": "object",
    "required": [
     "t",
     "until",
     "role"
    ],
    "properties": {
     "t": {
      "type": "number",
      "minimum": 0
     },
     "until": {
      "type": "number",
      "minimum": 0
     },
     "role": {
      "enum": [
       "refrain",
       "tagline",
       "line",
       "answer",
       "lift",
       "instrumental",
       "silence"
      ]
     },
     "motif": {
      "type": "string"
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "description": "Which return of the motif this is (1 = first)."
     },
     "gist": {
      "type": "string",
      "description": "Short paraphrase of what is sung (never verbatim lyrics)."
     },
     "image": {
      "enum": [
       "embrace",
       "gaze",
       "fire",
       "water",
       "duel",
       "meet",
       "urgency",
       "pride",
       "longing",
       "flirt",
       "hush",
       "hollow",
       "bloom",
       "rhythm"
      ],
      "description": "What the line is about, in light: the choreographer plays this image across every layer."
     },
     "dark": {
      "type": "boolean",
      "description": "On a silence: a true blackout (rare). Without it a silence holds a low breathing colour."
     },
     "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "additionalProperties": false
   }
  },
  "cues": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "t",
     "layer"
    ],
    "properties": {
     "t": {
      "type": "number",
      "minimum": 0
     },
     "until": {
      "type": "number",
      "minimum": 0
     },
     "layer": {
      "enum": [
       "beam",
       "spot",
       "wash",
       "pixel",
       "strobe",
       "laser",
       "blinder",
       "tube",
       "matrix",
       "all"
      ]
     },
     "group": {
      "enum": [
       "all",
       "left",
       "right",
       "odd",
       "even",
       "inner",
       "outer",
       "front",
       "back"
      ],
      "description": "Only these fixtures of the layer play the cue (default all). Lets one layer be two ensembles."
     },
     "move": {
      "type": "object",
      "required": [
       "look"
      ],
      "properties": {
       "look": {
        "enum": [
         "still",
         "fan",
         "fan_open",
         "fan_close",
         "sweep",
         "wave",
         "circle",
         "crossfire",
         "ballyhoo",
         "tunnel",
         "bounce",
         "snap",
         "swing",
         "pulse_fan",
         "domino",
         "spin",
         "cone",
         "vocal",
         "orbit",
         "lissajous",
         "helix",
         "lotus",
         "carousel",
         "curtain",
         "scissor",
         "ripple",
         "stairs",
         "scanline",
         "spiral",
         "peacock",
         "dance",
         "drift",
         "ribbon"
        ]
       },
       "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "speed": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Beats per cycle (bigger = slower)."
       },
       "spread": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "size": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "tilt": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
       },
       "on": {
        "enum": [
         "beat",
         "half",
         "bar",
         "phrase",
         "offbeat",
         "8th",
         "16th",
         "low",
         "mid",
         "high"
        ]
       },
       "every": {
        "type": "integer",
        "minimum": 1,
        "description": "Act on every Nth trigger."
       },
       "decay": {
        "type": "number",
        "minimum": 0,
        "description": "Seconds."
       },
       "width": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "direction": {
        "enum": [
         "forward",
         "reverse",
         "bounce",
         "out",
         "in"
        ]
       },
       "split": {
        "enum": [
         "lr",
         "oddeven"
        ]
       },
       "density": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "rate": {
        "type": "number",
        "minimum": 0,
        "maximum": 30,
        "description": "Flashes per second."
       },
       "ramp": {
        "type": "boolean"
       },
       "env": {
        "enum": [
         "energy",
         "low",
         "mid",
         "high"
        ]
       },
       "palette": {
        "type": "string"
       },
       "index": {
        "type": "integer",
        "minimum": 0
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       },
       "pose": {
        "enum": [
         "up",
         "out",
         "center",
         "cross",
         "audience",
         "down",
         "performer"
        ]
       },
       "pattern": {
        "enum": [
         "single",
         "double",
         "triple",
         "gallop",
         "heartbeat",
         "burst",
         "stutter",
         "split",
         "chase",
         "random"
        ]
       },
       "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 99999,
        "description": "Picks a variation of a figure."
       },
       "phase": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "glide": {
        "type": "number",
        "minimum": 0,
        "maximum": 16,
        "description": "Beats over which this look eases in from the previous one (default: a few beats; 0 = cut)."
       },
       "prism": {
        "type": "boolean",
        "description": "Insert the prism: each beam splits into a ring of rays."
       }
      },
      "additionalProperties": false
     },
     "dim": {
      "type": "object",
      "required": [
       "look"
      ],
      "properties": {
       "look": {
        "enum": [
         "on",
         "off",
         "follow",
         "pulse",
         "chase",
         "alternate",
         "breathe",
         "sparkle",
         "strobe",
         "swell",
         "fade",
         "dandiya_tap",
         "strobe_seq",
         "garba_circle",
         "comet",
         "meter",
         "ripple",
         "checker",
         "eq",
         "rain",
         "plasma",
         "diagonal",
         "thump"
        ]
       },
       "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "speed": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Beats per cycle (bigger = slower)."
       },
       "spread": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "size": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "tilt": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
       },
       "on": {
        "enum": [
         "beat",
         "half",
         "bar",
         "phrase",
         "offbeat",
         "8th",
         "16th",
         "low",
         "mid",
         "high"
        ]
       },
       "every": {
        "type": "integer",
        "minimum": 1,
        "description": "Act on every Nth trigger."
       },
       "decay": {
        "type": "number",
        "minimum": 0,
        "description": "Seconds."
       },
       "width": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "direction": {
        "enum": [
         "forward",
         "reverse",
         "bounce",
         "out",
         "in"
        ]
       },
       "split": {
        "enum": [
         "lr",
         "oddeven"
        ]
       },
       "density": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "rate": {
        "type": "number",
        "minimum": 0,
        "maximum": 30,
        "description": "Flashes per second."
       },
       "ramp": {
        "type": "boolean"
       },
       "env": {
        "enum": [
         "energy",
